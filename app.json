{
  "expo": {
    "name": "digital-readiness-app",
    "slug": "digital-readiness-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45524c8c-6953-4259-97a8-f0d379e39391"
      }
    },
    "android": {
      "package": "com.devmayowa.digitalreadinessapp"
    },
    "owner": "devmayowa"
  }
}
